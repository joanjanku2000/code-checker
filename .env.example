# Copy to .env and fill in. Never commit the real .env.

# --- Admin login for the lecturer area (/admin/**) ---
ADMIN_USERNAME=lecturer
# bcrypt hash of your password, NOT the password itself.
# Generate one:  docker run --rm python:3.12-alpine sh -c "pip -q install bcrypt && python -c \"import bcrypt;print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())\""
ADMIN_PASSWORD_HASH=

# --- Claude API, used only to generate the reference solution corpus ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Storage ---
CODETRIAGE_DATA_DIR=/var/lib/codetriage
