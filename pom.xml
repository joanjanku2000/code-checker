<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <groupId>io.codetriage</groupId>
  <artifactId>codetriage</artifactId>
  <version>0.1.0</version>
  <name>codetriage</name>
  <description>Lab submission intake and similarity triage for programming courses</description>

  <properties>
    <java.version>21</java.version>
    <!-- Pinned to the 6.2.x line on purpose. DO NOT bump without also moving
         java.version and both Docker images to 25.

         JPlag 6.3.0 ships Java 25 bytecode (class file version 69). A Java 21
         JVM cannot load it at all, and the failure reads as twenty "cannot find
         symbol" errors with one real line buried among them:
             class file has wrong version 69.0, should be 65.0
         6.2.0 is the last release built for JDK 21. The library API this project
         uses is identical across 6.x. -->
    <jplag.version>6.2.0</jplag.version>
    <pdfbox.version>3.0.8</pdfbox.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- JPlag: token-based structural similarity. NOTE: GPL-3.0 licensed. -->
    <dependency>
      <groupId>de.jplag</groupId>
      <artifactId>jplag</artifactId>
      <version>${jplag.version}</version>
    </dependency>
    <dependency>
      <groupId>de.jplag</groupId>
      <artifactId>java</artifactId>
      <version>${jplag.version}</version>
    </dependency>

    <!-- Assignment uploads arrive as PDF often enough to be worth a parser.
         .docx needs none: it is a zip of XML, handled in DocxTextExtractor. -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
